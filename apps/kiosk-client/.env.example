SERVER_URL=http://localhost:4000
# Optional for development. When omitted, the client uses the machine MAC address.
# KIOSK_ID is optional. Without it, the client uses the machine MAC address.
# KIOSK_TOKEN is optional. The first connection can enroll this MAC automatically.
KIOSK_TOKEN=
KIOSK_TOKEN_FILE=.kiosk-token
TEMP_DIR=./temp
MAX_DOWNLOAD_BYTES=52428800
DOWNLOAD_TIMEOUT_MS=60000