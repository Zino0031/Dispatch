[Unit]
Description=Print Kiosk client (Mini PC print agent)
After=network-online.target cups.service
Wants=network-online.target

[Service]
Type=simple
# Adjust to the checkout path on the Mini PC:
WorkingDirectory=/opt/print-kiosk/apps/kiosk-client
EnvironmentFile=/opt/print-kiosk/apps/kiosk-client/.env
ExecStart=/usr/bin/node /opt/print-kiosk/apps/kiosk-client/dist/index.js
Restart=always
RestartSec=5
# Credential files (.env, .kiosk-token) must stay readable only by this user.
UMask=0077
# Keep logs in the journal; rotate via journald (see docs/OPERATIONS.md).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
