{
  "services": {
    "print-kiosk-backend": {
      "root": "apps/backend",
      "entrypoint": "src/index.ts",
      "buildCommand": "npm ci && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "print-kiosk-backend"
      }
    }
  ]
}
